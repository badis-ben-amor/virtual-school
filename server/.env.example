Important! You must rename this file to .env and change the variable values for your website to work, this just an example

PORT=5000
CLIENT_URL=http://localhost:3000
ACCESS_TOKEN_SECRET_KEY=you_must_change_that_value_to_strong_secret_key
ACCESS_TOKEN_EXPIRES_IN=58s
REFRESH_TOKEN_SECRET_KEY=you_must_change_that_value_to_strong_secret_key
REFRESH_TOKEN_EXPIRES_IN=52d
REFRESH_TOKEN_MAX_AGE_DAYS=52
# database
MONGO_URL=mongodb://localhost:27017/your-db-name